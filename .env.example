# Supabase Configuration
# Get these from: https://supabase.com/dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# IMPORTANT: Never commit .env.local with real credentials
# Only use the publishable/anon key in frontend
# Never use service_role or secret keys in frontend code
